<Project>
  <!-- Global properties for all projects in the solution -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <!-- CS1591: Missing XML comment for public members (optional for internal classes) -->

    <!-- Package metadata -->
    <Authors>João Gabriel</Authors>
    <Company>Digital Signature Platform</Company>
    <Product>Digital Signature Platform</Product>
    <Version>0.1.0</Version>
    <PackageVersion>0.1.0</PackageVersion>
  </PropertyGroup>

  <!-- Dependency versions (centralized) -->
  <ItemGroup>
    <!-- MediatR and FluentValidation -->
    <!-- Note: MediatR v12+ is commercial. Using v11.x for OSS projects or substitute with custom mediator. -->
    <!-- FluentAssertions v7.x is OSS; v8+ is commercial. Using v7.x or Shouldly alternative. -->
    <PackageReference Include="MediatR" Version="11.1.0" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />

    <!-- Testing (xUnit, NSubstitute, FluentAssertions) -->
    <PackageReference Include="xunit" Version="2.7.1" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />

    <!-- EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Npgsql" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />

    <!-- Testing with real databases -->
    <PackageReference Include="Testcontainers" Version="3.7.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.7.0" />
  </ItemGroup>

  <!-- Analyzer configuration -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

</Project>

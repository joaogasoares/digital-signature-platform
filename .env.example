# Copy this file to .env and fill in real values
# NEVER commit .env to git

# PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=5432;Database=digitalsignature;Username=ds_user;Password=CHANGE_ME

# JWT (generate with: openssl rand -base64 32)
Jwt__Secret=CHANGE_ME_USE_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=digital-signature-platform
Jwt__Audience=digital-signature-platform
Jwt__ExpiryMinutes=60

# Encryption (generate with: openssl rand -base64 32)
Aes__MasterKey=CHANGE_ME_AES_256_KEY

# PFX Certificate (Semana 3)
Pfx__Path=/certs/signing.pfx
Pfx__Password=CHANGE_ME

# CORS
Cors__AllowedOrigins=https://your-frontend-domain.com

# Environment
ASPNETCORE_ENVIRONMENT=Production
